# PROMO-STUDIO 환경변수 템플릿
# 이 파일을 복사해서 .env 파일을 만들고 실제 값을 채우세요.
#
#   cp .env.example .env
#
# .env 파일은 .gitignore에 등록되어 있어 외부 노출되지 않습니다.

# === 필수 ===

# 노션 프로모션 대시보드 DB의 collection ID
# 형식: UUID (대시 포함, 36자)
# 확인 방법: 노션 DB 페이지 fetch 후 <data-source url="collection://..."> 태그
NOTION_DB_ID=YOUR_NOTION_DB_ID_HERE

# Gemini API 키 (HERO 이미지 생성에 사용)
# 발급: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE


# === 선택 (생략 시 기본값 사용) ===

# Gemini 모델 (생략 시 generate_hero.py의 기본값 사용)
# IMAGE_MODEL=gemini-3.1-flash-image-preview
# CONTENT_MODEL=gemini-3-flash-preview

# 본인 노션 user ID (담당자 필터용 — 생략 시 매번 안내)
# 확인 방법: 본인 프로필 URL 또는 본인이 담당자로 지정된 row의 담당자 필드
# NOTION_USER_ID=YOUR_NOTION_USER_ID

# 작업 파일 경로 오버라이드 (보통 불필요)
# NOTION_DATA=/path/to/notion_data.json
# OUT_DIR=/path/to/output
