# ============================================================================
#  promo-editor/.gitignore — 자동화 산출물·캐시 제외
# ============================================================================

# 자동화 캐시 (MCP 원문 + 검증 리포트)
.cache/

# 파이프라인 산출물 (브리지 파일 — 매 실행마다 갱신되는 5MB JSON)
notion_data.json
notion_data_report.txt
notion_raw.md

# OS·에디터 찌꺼기
.DS_Store
.vscode/
.idea/
*.swp

# 파이썬
__pycache__/
*.pyc
.venv/
venv/

# 로컬 테스트 결과물
PROMO_*/
*.zip
